{
  "name": "starter-tenplate-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "predev": "npm run starter:mode:published",
    "dev": "vite --port 3000",
    "predev:local-starter": "npm run starter:mode:local",
    "dev:local-starter": "USE_LOCAL_STARTER_SOURCE=true vite --port 3000",
    "predev:local-starter:dist": "npm run starter:mode:local",
    "dev:local-starter:dist": "USE_LOCAL_STARTER=true vite --port 3000",
    "starter:mode:local": "node scripts/set-starter-typescript-mode.mjs local",
    "starter:mode:published": "node scripts/set-starter-typescript-mode.mjs published",
    "architecture:check": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "pretypecheck:local-starter": "npm run starter:mode:local",
    "typecheck:local-starter": "tsc --noEmit -p tsconfig.local-starter.json",
    "prebuild:local-starter": "npm run starter:mode:local",
    "build:local-starter": "npm run typecheck:local-starter && USE_LOCAL_STARTER=true vite build",
    "prebuild": "npm run starter:mode:published",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "USE_LOCAL_STARTER=true vitest run",
    "test:published": "vitest run",
    "test:storybook": "STORYBOOK=true USE_LOCAL_STARTER=true vitest --config vitest.storybook.config.ts --run",
    "test:e2e": "playwright test",
    "storybook": "STORYBOOK=true USE_LOCAL_STARTER=true storybook dev -p 6007",
    "build-storybook": "STORYBOOK=true USE_LOCAL_STARTER=true storybook build",
    "verify": "bash scripts/verify.sh",
    "preview": "vite preview --port 3000"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-date-pickers": "^9.12.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.1",
    "@vireocodedev/starter-history": "^3.0.0",
    "@vireocodedev/starter-infrastructure": "^3.0.0",
    "@vireocodedev/starter-localization": "^3.0.0",
    "@vireocodedev/starter-queryengine": "^5.0.0",
    "@vireocodedev/starter-shell": "^4.0.0",
    "@vireocodedev/starter-ui": "^6.0.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@12.0.2"
}
