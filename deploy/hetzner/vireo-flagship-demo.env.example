POSTGRES_DB=vireo_flagship_demo
POSTGRES_OWNER_USER=vireo_flagship_demo_owner
POSTGRES_OWNER_PASSWORD=replace-with-a-long-random-owner-secret
POSTGRES_RUNTIME_USER=vireo_flagship_demo_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-a-distinct-long-random-runtime-secret
SESSION_COOKIE_SECURE=true
# The transaction controller selects 3001 (blue) or 3002 (green); do not set
# this in the host's mode-600 environment file.
