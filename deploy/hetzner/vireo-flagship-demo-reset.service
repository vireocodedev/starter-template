[Unit]
Description=Reset the isolated Vireo flagship demo
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists=/opt/apps/vireo-flagship-demo/.env

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/apps/vireo-flagship-demo
Environment=VIREO_DEMO_COMPOSE_PROJECT=vireo-flagship-demo
Environment=VIREO_DEMO_ENV_FILE=/opt/apps/vireo-flagship-demo/.env
Environment=VIREO_DEMO_RESET_CONFIRM=reset-vireo-demo
ExecStart=/opt/apps/vireo-flagship-demo/scripts/reset-flagship-demo.sh
UMask=0077
