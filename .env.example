# Required by Spring Boot outside the test profile.
# H2 offers a zero-service local start. Use PostgreSQL for production-like work.
# VIREO_DATABASE_MODE=h2
SPRING_DATASOURCE_URL=jdbc:h2:file:./.data/starter-template;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
